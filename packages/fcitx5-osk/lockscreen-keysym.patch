+            // currently, this method is only for inputting password in kscreenlocker.
+            //
+            // Send keysyms instead of raw keys: since KWin 6.8 (a8099a96) key and modifier
+            // requests are dropped unless the context holds a keyboard grab, and grabbing would
+            // also take the physical keyboard away from the lock screen. KWin maps keysyms back
+            // to key presses itself, including the shift needed for capital letters, so shift
+            // presses on their own are not forwarded.
+            if keycode == 50 || keycode == 62 || keyval == 0 {
+                return Ok(());
             }
+            let serial = self.serial.fetch_add(1, Ordering::Relaxed);

diff --git a/d2renderers/d2ascii/d2ascii_test.go b/d2renderers/d2ascii/d2ascii_test.go
new file mode 100644
index 0000000..16a2059
--- /dev/null
+++ b/d2renderers/d2ascii/d2ascii_test.go
@@ -0,0 +1,86 @@
+package d2ascii
+
+import (
+	"context"
+	"strings"
+	"testing"
+
+	"github.com/rivo/uniseg"
+
+	"oss.terrastruct.com/d2/d2renderers/d2ascii/charset"
+	"oss.terrastruct.com/d2/d2target"
+)
+
+func testDiagram(label string) *d2target.Diagram {
+	diagram := d2target.NewDiagram()
+	diagram.Shapes = []d2target.Shape{
+		{
+			Type:          d2target.ShapeRectangle,
+			Pos:           d2target.NewPoint(0, 0),
+			Width:         390,
+			Height:        180,
+			Text:          d2target.Text{Label: label},
+			LabelPosition: "INSIDE_MIDDLE_CENTER",
+		},
+	}
+	return diagram
+}
+
+func renderTestDiagram(t *testing.T, label string, scale float64) string {
+	t.Helper()
+	artist := NewASCIIartist()
+	output, err := artist.Render(context.Background(), testDiagram(label), &RenderOpts{
+		Scale:   &scale,
+		Charset: charset.Unicode,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return string(output)
+}
+
+func maxOutputWidth(output string) int {
+	maxWidth := 0
+	for _, line := range strings.Split(strings.TrimSuffix(output, "\n"), "\n") {
+		if width := uniseg.StringWidth(line); width > maxWidth {
+			maxWidth = width
+		}
+	}
+	return maxWidth
+}
+
+func TestRenderHonorsScale(t *testing.T) {
+	fullSize := renderTestDiagram(t, "node", 1)
+	halfSize := renderTestDiagram(t, "node", 0.5)
+
+	fullWidth := maxOutputWidth(fullSize)
+	halfWidth := maxOutputWidth(halfSize)
+	if halfWidth >= fullWidth {
+		t.Fatalf("scale 0.5 width = %d, want less than scale 1 width %d", halfWidth, fullWidth)
+	}
+}
+
+func TestRenderUsesArtistScaleWhenOptionIsUnset(t *testing.T) {
+	artist := NewASCIIartist()
+	artist.SCALE = 0.5
+	output, err := artist.Render(context.Background(), testDiagram("node"), &RenderOpts{Charset: charset.Unicode})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := maxOutputWidth(string(output)); got >= maxOutputWidth(renderTestDiagram(t, "node", 1)) {
+		t.Fatalf("artist scale width = %d, want less than scale 1", got)
+	}
+	if artist.SCALE != 0.5 {
+		t.Fatalf("artist scale after render = %v, want 0.5", artist.SCALE)
+	}
+}
+
+func TestRenderUnicodeMultilineLabel(t *testing.T) {
+	output := renderTestDiagram(t, "ポートピック\n🏳️‍🌈 port", 1)
+	if !strings.Contains(output, "ポートピック") {
+		t.Fatalf("CJK label is not contiguous:\n%s", output)
+	}
+	if !strings.Contains(output, "🏳️‍🌈 port") {
+		t.Fatalf("multiline emoji label is missing:\n%s", output)
+	}
+}

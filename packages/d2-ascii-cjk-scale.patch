--- /dev/null
+++ b/d2renderers/d2ascii/asciitext/asciitext.go
@@ -0,0 +1,18 @@
+package asciitext
+
+import (
+	"strings"
+
+	"github.com/rivo/uniseg"
+)
+
+// Width returns the terminal-cell width of the widest line in text.
+func Width(text string) int {
+	maxWidth := 0
+	for _, line := range strings.Split(text, "\n") {
+		if width := uniseg.StringWidth(line); width > maxWidth {
+			maxWidth = width
+		}
+	}
+	return maxWidth
+}
diff --git a/d2renderers/d2ascii/asciitext/asciitext_test.go b/d2renderers/d2ascii/asciitext/asciitext_test.go
new file mode 100644
index 0000000..e43cdf6
--- /dev/null
+++ b/d2renderers/d2ascii/asciitext/asciitext_test.go
@@ -0,0 +1,25 @@
+package asciitext
+
+import "testing"
+
+func TestWidth(t *testing.T) {
+	tests := []struct {
+		name string
+		text string
+		want int
+	}{
+		{name: "ascii", text: "local port", want: 10},
+		{name: "wide katakana", text: "ポートピック", want: 12},
+		{name: "combining", text: "e\u0301", want: 1},
+		{name: "emoji grapheme", text: "🏳️‍🌈", want: 2},
+		{name: "widest line", text: "ミニ\nlonger", want: 6},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := Width(tt.text); got != tt.want {
+				t.Fatalf("Width(%q) = %d, want %d", tt.text, got, tt.want)
+			}
+		})
+	}
+}

diff --git a/d2renderers/d2ascii/asciicanvas/asciicanvas.go b/d2renderers/d2ascii/asciicanvas/asciicanvas.go
index 5eda740..14f08c4 100644
--- a/d2renderers/d2ascii/asciicanvas/asciicanvas.go
+++ b/d2renderers/d2ascii/asciicanvas/asciicanvas.go
@@ -5,27 +5,55 @@ import (
 	"strings"
 	"unicode"
 
+	"github.com/rivo/uniseg"
+
 	"oss.terrastruct.com/d2/d2renderers/d2ascii/charset"
 )
 
 type Canvas struct {
-	grid [][]string
+	grid           [][]string
+	wideLabelOwner [][]int
 }
 
 func New(width, height int) *Canvas {
 	grid := make([][]string, height)
+	wideLabelOwner := make([][]int, height)
 	for i := range grid {
 		grid[i] = make([]string, width)
+		wideLabelOwner[i] = make([]int, width)
 		for j := range grid[i] {
 			grid[i][j] = " "
+			wideLabelOwner[i][j] = -1
 		}
 	}
-	return &Canvas{grid: grid}
+	return &Canvas{grid: grid, wideLabelOwner: wideLabelOwner}
 }
 
 func (c *Canvas) Set(x, y int, char string) {
+	if c.IsInBounds(x, y) && c.wideLabelOwner[y][x] == -1 {
+		c.grid[y][x] = char
+	}
+}
+
+func (c *Canvas) clearWideLabelAt(x, y int) {
+	if !c.IsInBounds(x, y) {
+		return
+	}
+	owner := c.wideLabelOwner[y][x]
+	if owner == -1 {
+		return
+	}
+	for column := owner; c.IsInBounds(column, y) && c.wideLabelOwner[y][column] == owner; column++ {
+		c.grid[y][column] = " "
+		c.wideLabelOwner[y][column] = -1
+	}
+}
+
+func (c *Canvas) setLabelCell(x, y int, char string, wideOwner int) {
 	if c.IsInBounds(x, y) {
+		c.clearWideLabelAt(x, y)
 		c.grid[y][x] = char
+		c.wideLabelOwner[y][x] = wideOwner
 	}
 }
 
@@ -52,11 +80,41 @@ func (c *Canvas) Height() int {
 }
 
 func (c *Canvas) DrawLabel(x, y int, label string) {
-	if !c.IsInBounds(x, y) {
-		return
+	for lineIndex, line := range strings.Split(label, "\n") {
+		column := x
+		graphemes := uniseg.NewGraphemes(line)
+		for graphemes.Next() {
+			width := graphemes.Width()
+			if width <= 0 {
+				continue
+			}
+
+			row := y + lineIndex
+			if !c.IsInBounds(column, row) || !c.IsInBounds(column+width-1, row) {
+				column += width
+				continue
+			}
+
+			wideOwner := -1
+			if width > 1 {
+				wideOwner = column
+			}
+			c.setLabelCell(column, row, graphemes.Str(), wideOwner)
+			// A wide grapheme occupies multiple terminal cells. Empty continuation
+			// cells preserve canvas coordinates without printing extra spaces. The
+			// owner keeps routes from overwriting only part of a wide grapheme.
+			for offset := 1; offset < width; offset++ {
+				c.setLabelCell(column+offset, row, "", wideOwner)
+			}
+			column += width
+		}
 	}
-	for i, ch := range label {
-		c.Set(x+i, y, string(ch))
+}
+
+func (c *Canvas) DrawLabelCentered(x, y, width int, label string) {
+	for lineIndex, line := range strings.Split(label, "\n") {
+		lineX := x + (width-uniseg.StringWidth(line))/2
+		c.DrawLabel(lineX, y+lineIndex, line)
 	}
 }
 
diff --git a/d2renderers/d2ascii/asciicanvas/asciicanvas_test.go b/d2renderers/d2ascii/asciicanvas/asciicanvas_test.go
new file mode 100644
index 0000000..ed8ba66
--- /dev/null
+++ b/d2renderers/d2ascii/asciicanvas/asciicanvas_test.go
@@ -0,0 +1,57 @@
+package asciicanvas
+
+import "testing"
+
+func TestDrawLabelUsesTerminalCellWidths(t *testing.T) {
+	canvas := New(12, 2)
+	canvas.DrawLabel(1, 0, "Aカ🏳️‍🌈e\u0301\nカナ")
+
+	wantFirstRow := map[int]string{
+		1: "A",
+		2: "カ",
+		3: "",
+		4: "🏳️‍🌈",
+		5: "",
+		6: "e\u0301",
+	}
+	for column, want := range wantFirstRow {
+		if got := canvas.Get(column, 0); got != want {
+			t.Errorf("cell (%d, 0) = %q, want %q", column, got, want)
+		}
+	}
+
+	wantSecondRow := map[int]string{1: "カ", 2: "", 3: "ナ", 4: ""}
+	for column, want := range wantSecondRow {
+		if got := canvas.Get(column, 1); got != want {
+			t.Errorf("cell (%d, 1) = %q, want %q", column, got, want)
+		}
+	}
+
+	for column := 1; column <= 4; column++ {
+		canvas.Set(column, 1, "─")
+	}
+	for column, want := range wantSecondRow {
+		if got := canvas.Get(column, 1); got != want {
+			t.Errorf("route overwrote wide label cell (%d, 1): got %q, want %q", column, got, want)
+		}
+	}
+
+	canvas.DrawLabel(1, 1, "A")
+	if got := canvas.Get(1, 1); got != "A" {
+		t.Errorf("overlapping label lead = %q, want A", got)
+	}
+	if got := canvas.Get(2, 1); got != " " {
+		t.Errorf("overlapping label left stale continuation cell: got %q", got)
+	}
+}
+
+func TestDrawLabelSkipsWideGraphemeOutsideCanvas(t *testing.T) {
+	canvas := New(4, 1)
+	canvas.DrawLabel(-1, 0, "カA")
+	if got := canvas.Get(0, 0); got != " " {
+		t.Fatalf("orphan continuation cell at left edge: got %q", got)
+	}
+	if got := canvas.Get(1, 0); got != "A" {
+		t.Fatalf("following label cell = %q, want A", got)
+	}
+}

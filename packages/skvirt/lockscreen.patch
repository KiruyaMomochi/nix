diff --git a/tests/lockscreen.cpp b/tests/lockscreen.cpp
new file mode 100644
index 0000000..c1d2add
--- /dev/null
+++ b/tests/lockscreen.cpp
@@ -0,0 +1,139 @@
+#include "KeyboardController.h"
+#include <QCoreApplication>
+#include <QDebug>
+#include <QVector>
+#include "KWinLauncher.h"
+#include <KConfig>
+#include <KConfigGroup>
+#include <KConfigWatcher>
+#include <KSharedConfig>
+#include <QDBusConnection>
+#include <QDBusMessage>
+#include <QDBusVirtualObject>
+#include <QDBusVariant>
+#include <QEventLoop>
+#include <QTemporaryDir>
+#include <QTimer>
+
+class Services : public QDBusVirtualObject
+{
+public:
+    int reconfigures = 0;
+    QStringList commands;
+    bool concurrentSelection = false;
+    void readCommand(const QDBusConnection &bus)
+    {
+        KConfig config("kwinrc", KConfig::NoGlobals);
+        KConfigGroup wayland(&config, "Wayland");
+        commands.append(wayland.readEntry("InputMethod", QString()));
+        if (concurrentSelection) {
+            wayland.writeEntry("InputMethod", "another.desktop");
+            config.sync();
+        }
+        ++reconfigures;
+        bus.send(QDBusMessage::createSignal("/VirtualKeyboard",
+            "org.kde.kwin.VirtualKeyboard", "availableChanged"));
+    }
+    QString introspect(const QString &) const override { return {}; }
+    bool handleMessage(const QDBusMessage &message, const QDBusConnection &bus) override
+    {
+        if (message.member() == QLatin1String("GetActive")) {
+            bus.send(message.createReply(false));
+            return true;
+        }
+        if (message.member() == QLatin1String("Get")) {
+            bus.send(message.createReply(QVariant::fromValue(QDBusVariant(!commands.last().isEmpty()))));
+            return true;
+        }
+        return false;
+    }
+};
+
+int main(int argc, char **argv)
+{
+    QCoreApplication app(argc, argv);
+    KeyboardController controller(nullptr, true);
+    QVector<uint> keys;
+    QObject::connect(&controller, &KeyboardController::keysymRequested,
+                     &app, [&](uint sym) { keys.append(sym); });
+    const auto check = [](bool value, const char *message) {
+        if (!value) qFatal("%s", message);
+    };
+    QCoreApplication::processEvents();
+    check(controller.lockScreen(), "lockscreen mode must not initialize desktop backends");
+    check(controller.generatedRows().isEmpty(), "password keyboard must use the US fallback");
+    check(!controller.voiceAvailable() && controller.suggestions().isEmpty(),
+          "passwords must not reach speech or suggestion engines");
+    for (uint ch = 32; ch < 127; ++ch) {
+        controller.commitText(QString(QChar(ch)));
+        check(keys.takeLast() == ch, "printable ASCII must retain its exact keysym");
+    }
+    controller.toggleShift();
+    controller.commitText(QStringLiteral("A"));
+    check(keys.takeLast() == 'A' && !controller.shiftActive(), "shift must be one-shot");
+    controller.commitKeyAt(QStringLiteral("1"), true, QStringLiteral("!"));
+    check(keys.takeLast() == '!', "positional keys must send the displayed symbol on lockscreen");
+    controller.sendSpecial(QStringLiteral("backspace"));
+    controller.sendSpecial(QStringLiteral("enter"));
+    controller.sendSpecial(QStringLiteral("space"));
+    check(keys == QVector<uint>({0xff08, 0xff0d, 0x20}), "password editing keysyms");
+    keys.clear();
+    controller.sendSpecial(QStringLiteral("not-a-key"));
+    controller.commitSuggestion(0);
+    controller.cycleLayout();
+    controller.startVoiceInput();
+    check(keys.isEmpty(), "unavailable actions must not send keys");
+    QTemporaryDir configDir;
+    check(configDir.isValid(), "temporary config directory");
+    qputenv("XDG_CONFIG_HOME", configDir.path().toUtf8());
+    auto bus = QDBusConnection::sessionBus();
+    check(bus.registerService("org.kde.KWin"), "isolated KWin test service");
+    check(bus.registerService("org.kde.keyboard"), "isolated keyboard test service");
+    check(bus.registerService("org.freedesktop.ScreenSaver"), "isolated screen saver service");
+    Services services;
+    bus.registerVirtualObject("/KWin", &services);
+    bus.registerVirtualObject("/VirtualKeyboard", &services);
+    bus.registerVirtualObject("/ScreenSaver", &services);
+    const QString desktop = QStringLiteral("/test/org.skvirt.KWinLauncher.desktop");
+    auto setCommand = [](const QString &command) {
+        KConfig config("kwinrc", KConfig::NoGlobals);
+        KConfigGroup(&config, "Wayland").writeEntry("InputMethod", command);
+        config.sync();
+    };
+    auto settle = [] {
+        QEventLoop loop;
+        QTimer::singleShot(100, &loop, &QEventLoop::quit);
+        loop.exec();
+    };
+    setCommand(desktop);
+    const auto configWatcher = KConfigWatcher::create(KSharedConfig::openConfig("kwinrc", KConfig::NoGlobals));
+    QObject::connect(configWatcher.data(), &KConfigWatcher::configChanged, &services,
+        [&](const KConfigGroup &group, const QByteArrayList &keys) {
+            if (group.name() == "Wayland" && keys.contains("InputMethod"))
+                QTimer::singleShot(20, &services, [&] { services.readCommand(bus); });
+        });
+    KWinLauncherWatcher watcher;
+    watcher.activeChanged(true);
+    settle();
+    check(services.commands == QStringList({QString(), desktop}), "lock transition must obtain a fresh KWin socket and restore configuration");
+    watcher.activeChanged(true);
+    settle();
+    check(services.reconfigures == 2, "duplicate lock state must not restart input method");
+    services.commands.clear();
+    watcher.activeChanged(false);
+    settle();
+    check(services.commands == QStringList({QString(), desktop}), "unlock must return the socket to fcitx5");
+    setCommand("another.desktop");
+    watcher.restart();
+    settle();
+    check(services.reconfigures == 4, "do not change another selected keyboard");
+    setCommand(desktop);
+    services.concurrentSelection = true;
+    watcher.restart();
+    settle();
+    KConfig restored("kwinrc", KConfig::NoGlobals);
+    check(KConfigGroup(&restored, "Wayland").readEntry("InputMethod", QString()) == "another.desktop",
+          "do not overwrite a keyboard chosen while reconfiguring");
+    check(services.reconfigures == 5, "concurrent selection must skip restoration");
+    qInfo() << "lockscreen controller and launcher tests passed";
+}

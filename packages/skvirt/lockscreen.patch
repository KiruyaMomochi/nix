diff --git a/src/LockScreenInput.cpp b/src/LockScreenInput.cpp
new file mode 100644
index 0000000..38e1817
--- /dev/null
+++ b/src/LockScreenInput.cpp
@@ -0,0 +1,207 @@
+#include "LockScreenInput.h"
+#include "KeyboardController.h"
+#include "SettingsBridge.h"
+#include <QApplication>
+#include <QDebug>
+#include <QPlatformSurfaceEvent>
+#include <QQmlEngine>
+#include <QQuickItem>
+#include <QQuickView>
+#include <QScreen>
+#include <qpa/qplatformnativeinterface.h>
+#include <cstring>
+
+LockScreenInput::LockScreenInput(QQuickView *view) : QObject(view), m_view(view)
+{
+    m_time.start();
+    m_view->installEventFilter(this);
+}
+
+LockScreenInput::~LockScreenInput()
+{
+    m_view->removeEventFilter(this);
+    destroyPanel();
+    clearContext();
+    if (m_method) zwp_input_method_v1_destroy(m_method);
+    if (m_panel) zwp_input_panel_v1_destroy(m_panel);
+    if (m_registry) wl_registry_destroy(m_registry);
+}
+
+bool LockScreenInput::initialize()
+{
+    auto *native = QGuiApplication::platformNativeInterface();
+    m_display = static_cast<wl_display *>(native->nativeResourceForIntegration("wl_display"));
+    if (!m_display)
+        return false;
+    m_registry = wl_display_get_registry(m_display);
+    static const wl_registry_listener listener = {global, globalRemoved};
+    wl_registry_add_listener(m_registry, &listener, this);
+    if (wl_display_roundtrip(m_display) < 0 || !m_method || !m_panel)
+        return false;
+    return wl_display_roundtrip(m_display) >= 0;
+}
+
+void LockScreenInput::global(void *data, wl_registry *registry, uint32_t name,
+                             const char *interface, uint32_t)
+{
+    auto *self = static_cast<LockScreenInput *>(data);
+    if (std::strcmp(interface, zwp_input_method_v1_interface.name) == 0) {
+        self->m_methodName = name;
+        self->m_method = static_cast<zwp_input_method_v1 *>(
+            wl_registry_bind(registry, name, &zwp_input_method_v1_interface, 1));
+        static const zwp_input_method_v1_listener listener = {activate, deactivate};
+        zwp_input_method_v1_add_listener(self->m_method, &listener, self);
+    } else if (std::strcmp(interface, zwp_input_panel_v1_interface.name) == 0) {
+        self->m_panelName = name;
+        self->m_panel = static_cast<zwp_input_panel_v1 *>(
+            wl_registry_bind(registry, name, &zwp_input_panel_v1_interface, 1));
+    }
+}
+
+void LockScreenInput::globalRemoved(void *data, wl_registry *, uint32_t name)
+{
+    auto *self = static_cast<LockScreenInput *>(data);
+    if (name == self->m_methodName || name == self->m_panelName)
+        QCoreApplication::exit(1);
+}
+
+void LockScreenInput::activate(void *data, zwp_input_method_v1 *, zwp_input_method_context_v1 *context)
+{
+    auto *self = static_cast<LockScreenInput *>(data);
+    self->clearContext();
+    self->m_context = context;
+    static const zwp_input_method_context_v1_listener listener = {
+        surroundingText, reset, contentType, invokeAction, commitState, preferredLanguage
+    };
+    zwp_input_method_context_v1_add_listener(context, &listener, self);
+    self->m_view->show();
+}
+
+void LockScreenInput::deactivate(void *data, zwp_input_method_v1 *, zwp_input_method_context_v1 *context)
+{
+    auto *self = static_cast<LockScreenInput *>(data);
+    if (context != self->m_context)
+        return;
+    self->clearContext();
+    self->m_view->hide();
+}
+
+void LockScreenInput::clearContext()
+{
+    if (m_context) {
+        zwp_input_method_context_v1_destroy(m_context);
+        m_context = nullptr;
+    }
+    m_serial = 0;
+    emit resetKeys();
+}
+
+void LockScreenInput::surroundingText(void *, zwp_input_method_context_v1 *, const char *, uint32_t, uint32_t) {}
+void LockScreenInput::reset(void *data, zwp_input_method_context_v1 *)
+{
+    emit static_cast<LockScreenInput *>(data)->resetKeys();
+}
+void LockScreenInput::contentType(void *, zwp_input_method_context_v1 *, uint32_t, uint32_t) {}
+void LockScreenInput::invokeAction(void *, zwp_input_method_context_v1 *, uint32_t, uint32_t) {}
+void LockScreenInput::preferredLanguage(void *, zwp_input_method_context_v1 *, const char *) {}
+void LockScreenInput::commitState(void *data, zwp_input_method_context_v1 *, uint32_t serial)
+{
+    static_cast<LockScreenInput *>(data)->m_serial = serial;
+}
+
+void LockScreenInput::sendKeysym(uint symbol)
+{
+    if (!m_context || !symbol)
+        return;
+    const auto time = uint32_t(m_time.elapsed());
+    // KWin 6.8 drops context.key without a keyboard grab. keysym needs no grab.
+    zwp_input_method_context_v1_keysym(m_context, m_serial, time, symbol, WL_KEYBOARD_KEY_STATE_PRESSED, 0);
+    zwp_input_method_context_v1_keysym(m_context, m_serial, time, symbol, WL_KEYBOARD_KEY_STATE_RELEASED, 0);
+    wl_display_flush(m_display);
+}
+
+void LockScreenInput::resizePanel()
+{
+    if (!m_view->rootObject() || !m_view->screen())
+        return;
+    m_view->setWidth(m_view->screen()->size().width());
+    m_view->setHeight(m_view->rootObject()->property("desiredHeight").toInt());
+}
+
+void LockScreenInput::createPanel()
+{
+    if (m_surface || !m_panel)
+        return;
+    auto *native = QGuiApplication::platformNativeInterface();
+    auto *surface = static_cast<wl_surface *>(native->nativeResourceForWindow("surface", m_view));
+    auto *output = static_cast<wl_output *>(native->nativeResourceForScreen("output", m_view->screen()));
+    if (!surface || !output) {
+        qCritical() << "skvirt: lockscreen surface or output unavailable";
+        QCoreApplication::exit(1);
+        return;
+    }
+    m_surface = zwp_input_panel_v1_get_input_panel_surface(m_panel, surface);
+    zwp_input_panel_surface_v1_set_toplevel(m_surface, output,
+                                           ZWP_INPUT_PANEL_SURFACE_V1_POSITION_CENTER_BOTTOM);
+}
+
+void LockScreenInput::destroyPanel()
+{
+    if (m_surface) {
+        zwp_input_panel_surface_v1_destroy(m_surface);
+        m_surface = nullptr;
+    }
+}
+
+bool LockScreenInput::eventFilter(QObject *object, QEvent *event)
+{
+    if (object == m_view && event->type() == QEvent::PlatformSurface) {
+        auto *surfaceEvent = static_cast<QPlatformSurfaceEvent *>(event);
+        if (surfaceEvent->surfaceEventType() == QPlatformSurfaceEvent::SurfaceCreated)
+            createPanel();
+        else
+            destroyPanel();
+    }
+    return QObject::eventFilter(object, event);
+}
+
+int runLockScreen(int argc, char **argv)
+{
+    if (!qEnvironmentVariableIsSet("WAYLAND_SOCKET")) {
+        qCritical() << "skvirt: --lockscreen requires KWin's WAYLAND_SOCKET";
+        return 1;
+    }
+    qputenv("QT_QPA_PLATFORM", "wayland");
+    qputenv("QT_WAYLAND_USE_BYPASSWINDOWMANAGERHINT", "1");
+    qunsetenv("QT_WAYLAND_SHELL_INTEGRATION");
+    QApplication app(argc, argv);
+    app.setApplicationName("skvirt");
+    app.setOrganizationName("skvirt");
+    app.setQuitOnLastWindowClosed(false);
+    KeyboardController controller(nullptr, true);
+    qmlRegisterSingletonInstance("skvirt", 1, 0, "KeyboardController", &controller);
+    qmlRegisterSingletonType<SettingsBridge>("skvirt", 1, 0, "Settings",
+        [](QQmlEngine *, QJSEngine *) -> QObject * { return new SettingsBridge(); });
+    QQuickView view;
+    view.setFlags(Qt::FramelessWindowHint | Qt::BypassWindowManagerHint | Qt::WindowDoesNotAcceptFocus);
+    view.setColor(Qt::transparent);
+    view.setResizeMode(QQuickView::SizeRootObjectToView);
+    LockScreenInput input(&view);
+    if (!input.initialize()) {
+        qCritical() << "skvirt: KWin input-method-v1/input-panel-v1 unavailable";
+        return 1;
+    }
+    QObject::connect(&controller, &KeyboardController::keysymRequested, &input, &LockScreenInput::sendKeysym);
+    QObject::connect(&input, &LockScreenInput::resetKeys, &controller, [&controller] {
+        if (controller.shiftActive()) controller.toggleShift();
+        if (controller.capsLock()) controller.toggleCapsLock();
+    });
+    view.setSource(QUrl(QStringLiteral("qrc:/skvirt/src/qml/SkvirtKeyboard.qml")));
+    if (view.status() == QQuickView::Error)
+        return 1;
+    QObject::connect(view.rootObject(), SIGNAL(desiredHeightChanged()), &input, SLOT(resizePanel()));
+    QObject::connect(view.screen(), &QScreen::geometryChanged, &input, &LockScreenInput::resizePanel);
+    QObject::connect(&view, &QQuickView::screenChanged, &input, &LockScreenInput::resizePanel);
+    input.resizePanel();
+    return app.exec();
+}

diff --git a/src/KWinLauncher.cpp b/src/KWinLauncher.cpp
new file mode 100644
index 0000000..765c37e
--- /dev/null
+++ b/src/KWinLauncher.cpp
@@ -0,0 +1,206 @@
+#include "KWinLauncher.h"
+#include <KConfig>
+#include <KConfigGroup>
+#include <QCoreApplication>
+#include <QDBusConnection>
+#include <QDBusConnectionInterface>
+#include <QDBusInterface>
+#include <QDBusMessage>
+#include <QDBusReply>
+#include <QDBusServiceWatcher>
+#include <QDBusUnixFileDescriptor>
+#include <QDBusVariant>
+#include <QDebug>
+#include <QFileInfo>
+#include <QTimer>
+#include <fcntl.h>
+#include <unistd.h>
+
+namespace {
+constexpr auto service = "org.skvirt.KWinLauncher";
+constexpr auto path = "/org/skvirt/KWinLauncher";
+
+QDBusReply<bool> screenLocked()
+{
+    QDBusInterface screenSaver("org.freedesktop.ScreenSaver", "/ScreenSaver",
+                              "org.freedesktop.ScreenSaver");
+    return screenSaver.call("GetActive");
+}
+}
+
+KWinLauncherWatcher::KWinLauncherWatcher(QObject *parent) : QObject(parent)
+{
+    auto bus = QDBusConnection::sessionBus();
+    bus.connect("org.freedesktop.ScreenSaver", "/ScreenSaver",
+                "org.freedesktop.ScreenSaver", "ActiveChanged",
+                this, SLOT(activeChanged(bool)));
+    bus.connect("org.kde.keyboard", "/VirtualKeyboard", "org.kde.kwin.VirtualKeyboard",
+                "availableChanged", this, SLOT(availableChanged()));
+    m_timeout.setSingleShot(true);
+    m_timeout.setInterval(5000);
+    connect(&m_timeout, &QTimer::timeout, this, [this] {
+        qWarning() << "skvirt: timed out waiting for KWin input-method state";
+        if (!m_desktop.isEmpty()) restore();
+        else finishRestart();
+    });
+    const auto locked = screenLocked();
+    if (locked.isValid())
+        m_active = locked.value();
+}
+
+void KWinLauncherWatcher::activeChanged(bool active)
+{
+    if (m_active == active)
+        return;
+    m_active = active;
+    restart();
+}
+
+void KWinLauncherWatcher::ensureMode(bool locked)
+{
+    if (m_active != locked)
+        QTimer::singleShot(0, this, &KWinLauncherWatcher::restart);
+}
+
+void KWinLauncherWatcher::restart()
+{
+    if (m_restarting) {
+        m_pending = true;
+        return;
+    }
+    KConfig config("kwinrc", KConfig::NoGlobals);
+    KConfigGroup wayland(&config, "Wayland");
+    const QString desktop = wayland.readEntry("InputMethod", QString());
+    if (QFileInfo(desktop).fileName() != QLatin1String("org.skvirt.KWinLauncher.desktop"))
+        return;
+
+    // KWin grants a new privileged socket when its input-method command changes.
+    m_restarting = true;
+    m_desktop = desktop;
+    m_timeout.start();
+    wayland.deleteEntry("InputMethod", KConfig::Notify);
+    if (!config.sync()) {
+        qWarning() << "skvirt: cannot reset KWin input method";
+        finishRestart();
+    }
+}
+
+void KWinLauncherWatcher::availableChanged()
+{
+    if (!m_restarting)
+        return;
+    auto query = QDBusMessage::createMethodCall("org.kde.keyboard", "/VirtualKeyboard",
+        "org.freedesktop.DBus.Properties", "Get");
+    query.setArguments({QStringLiteral("org.kde.kwin.VirtualKeyboard"), QStringLiteral("available")});
+    const QDBusReply<QDBusVariant> reply = QDBusConnection::sessionBus().call(query);
+    if (!reply.isValid())
+        return;
+    const bool available = reply.value().variant().toBool();
+    if (!available && !m_desktop.isEmpty())
+        restore();
+    else if (available && m_desktop.isEmpty())
+        finishRestart();
+}
+
+void KWinLauncherWatcher::restore()
+{
+    KConfig config("kwinrc", KConfig::NoGlobals);
+    KConfigGroup wayland(&config, "Wayland");
+    if (wayland.hasKey("InputMethod")) {
+        m_pending = false;
+        finishRestart();
+        return;
+    }
+    // Leave a concurrently selected input method alone.
+    wayland.writeEntry("InputMethod", m_desktop, KConfig::Notify);
+    if (!config.sync())
+        qWarning() << "skvirt: cannot restore KWin input method";
+    m_desktop.clear();
+    m_timeout.start();
+}
+
+void KWinLauncherWatcher::finishRestart()
+{
+    m_timeout.stop();
+    m_desktop.clear();
+    m_restarting = false;
+    if (m_pending) {
+        m_pending = false;
+        restart();
+    }
+}
+
+int runKWinLauncher(int argc, char **argv)
+{
+    QCoreApplication app(argc, argv);
+    app.setApplicationName("skvirt-kwin-launcher");
+    auto bus = QDBusConnection::sessionBus();
+    if (!bus.isConnected()) {
+        qCritical() << "skvirt: session bus unavailable";
+        return 1;
+    }
+    if (app.arguments().contains(QStringLiteral("--kwin-watch"))) {
+        if (!bus.registerService(service))
+            return 0;
+        KWinLauncherWatcher watcher;
+        bus.registerObject(path, &watcher, QDBusConnection::ExportAllSlots);
+        QObject::connect(bus.interface(), &QDBusConnectionInterface::serviceOwnerChanged, &app,
+                [&app](const QString &name, const QString &, const QString &owner) {
+            if (name == QLatin1String("org.kde.KWin") && owner.isEmpty())
+                app.quit();
+        });
+        return app.exec();
+    }
+
+    bool valid = false;
+    const int socket = qEnvironmentVariableIntValue("WAYLAND_SOCKET", &valid);
+    if (!valid || socket < 0 || fcntl(socket, F_GETFD) < 0) {
+        qCritical() << "skvirt: --kwin-launcher requires KWin's WAYLAND_SOCKET";
+        return 1;
+    }
+    const int flags = fcntl(socket, F_GETFD);
+    if (fcntl(socket, F_SETFD, flags | FD_CLOEXEC) < 0)
+        return 1;
+
+    const auto locked = screenLocked();
+    if (!locked.isValid()) {
+        qCritical() << "skvirt: cannot read screen-lock state:" << locked.error().message();
+        close(socket);
+        return 1;
+    }
+    QDBusInterface modeWatcher(service, path, service);
+    const auto watching = modeWatcher.call("ensureMode", locked.value());
+    if (watching.type() == QDBusMessage::ErrorMessage) {
+        qCritical() << "skvirt: cannot start lock-state watcher:" << watching.errorMessage();
+        close(socket);
+        return 1;
+    }
+    if (locked.value()) {
+        if (fcntl(socket, F_SETFD, flags & ~FD_CLOEXEC) < 0)
+            return 1;
+        const QByteArray executable = QCoreApplication::applicationFilePath().toLocal8Bit();
+        char *args[] = {const_cast<char *>(executable.constData()), const_cast<char *>("--lockscreen"), nullptr};
+        execv(executable.constData(), args);
+        qCritical() << "skvirt: cannot start lockscreen keyboard";
+        close(socket);
+        return 1;
+    }
+
+    // D-Bus activates fcitx5 if needed; Qt never consumes the privileged socket.
+    QDBusInterface fcitx("org.fcitx.Fcitx5", "/controller", "org.fcitx.Fcitx.Controller1");
+    QDBusUnixFileDescriptor descriptor(socket);
+    QDBusMessage reply = fcitx.call("OpenWaylandConnectionSocket", QVariant::fromValue(descriptor));
+    close(socket);
+    qunsetenv("WAYLAND_SOCKET");
+    if (reply.type() == QDBusMessage::ErrorMessage) {
+        qCritical() << "skvirt: cannot give KWin socket to fcitx5:" << reply.errorMessage();
+        return 1;
+    }
+    QDBusServiceWatcher fcitxWatcher("org.fcitx.Fcitx5", bus,
+                                   QDBusServiceWatcher::WatchForUnregistration);
+    QObject::connect(&fcitxWatcher, &QDBusServiceWatcher::serviceUnregistered, &app, [] {
+        QDBusInterface launcher(service, path, service);
+        launcher.asyncCall("restart");
+    });
+    return app.exec();
+}

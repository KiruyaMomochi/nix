+
+class KWinLauncherWatcher : public QObject
+{
+    Q_OBJECT
+    Q_CLASSINFO("D-Bus Interface", "org.skvirt.KWinLauncher")
+public:
+    explicit KWinLauncherWatcher(QObject *parent = nullptr);
+public slots:
+    void activeChanged(bool active);
+    void ensureMode(bool locked);
+    void restart();
+    void availableChanged();
+private:
+    void restore();
+    void finishRestart();
+    QString m_desktop;
+    QTimer m_timeout;
+    bool m_active = false;
+    bool m_restarting = false;
+    bool m_pending = false;
+};
+
+int runKWinLauncher(int argc, char **argv);

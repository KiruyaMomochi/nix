diff --git a/pkg/plugin/settings.go b/pkg/plugin/settings.go
index d305324..9842740 100644
--- a/pkg/plugin/settings.go
+++ b/pkg/plugin/settings.go
@@ -4,6 +4,7 @@ import (
 	"context"
 	"encoding/json"
 	"fmt"
+	"net/url"
 	"strconv"
 	"strings"
 	"time"
@@ -186,6 +187,38 @@ func LoadSettings(ctx context.Context, config backend.DataSourceInstanceSettings
 		}
 	}
 
+	// Accept a full URL in the host field (e.g. "http://127.0.0.1:4000").
+	// The config UI and the frontend proxy route ({{ .JsonData.host }}) both
+	// treat host as a URL, but this backend expects a bare hostname plus a
+	// separate port field. Split the URL so both consumers can share one
+	// datasource config. Explicitly configured fields keep priority.
+	if strings.Contains(settings.Host, "://") {
+		if u, parseErr := url.Parse(settings.Host); parseErr == nil && u.Hostname() != "" {
+			settings.Host = u.Hostname()
+			if settings.Port == 0 {
+				if p := u.Port(); p != "" {
+					if port, portErr := strconv.ParseInt(p, 10, 64); portErr == nil {
+						settings.Port = port
+					}
+				} else if u.Scheme == "https" {
+					settings.Port = 443
+				} else {
+					settings.Port = 80
+				}
+			}
+			// A URL implies the HTTP interface, not the native protocol.
+			if settings.Protocol == "" {
+				settings.Protocol = "http"
+			}
+			if u.Scheme == "https" {
+				settings.Secure = true
+			}
+			if settings.Path == "" && u.Path != "" && u.Path != "/" {
+				settings.Path = u.Path
+			}
+		}
+	}
+
 	// Set default values
 	if strings.TrimSpace(settings.DialTimeout) == "" {
 		settings.DialTimeout = "10"
diff --git a/pkg/plugin/settings_url_host_test.go b/pkg/plugin/settings_url_host_test.go

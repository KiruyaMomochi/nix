@@ -0,0 +1,88 @@
+package plugin
+
+import (
+	"context"
+	"encoding/json"
+	"testing"
+
+	"github.com/grafana/grafana-plugin-sdk-go/backend"
+	"github.com/stretchr/testify/assert"
+)
+
+func testCtxWithSQLDefaults() context.Context {
+	return backend.WithGrafanaConfig(context.Background(), backend.NewGrafanaCfg(map[string]string{
+		"GF_SQL_ROW_LIMIT":                         "1000000",
+		"GF_SQL_MAX_OPEN_CONNS_DEFAULT":            "10",
+		"GF_SQL_MAX_IDLE_CONNS_DEFAULT":            "10",
+		"GF_SQL_MAX_CONN_LIFETIME_SECONDS_DEFAULT": "60",
+	}))
+}
+
+// Our provisioned config: host is a full URL, no port field.
+// Dashboard proxy route needs the URL form; backend must split it.
+func TestLoadSettingsWithURLHost(t *testing.T) {
+	jsonData := map[string]interface{}{
+		"host":            "http://127.0.0.1:4000",
+		"defaultDatabase": "public",
+	}
+	raw, _ := json.Marshal(jsonData)
+	settings, err := LoadSettings(testCtxWithSQLDefaults(), backend.DataSourceInstanceSettings{JSONData: raw})
+	assert.NoError(t, err)
+	assert.Equal(t, "127.0.0.1", settings.Host)
+	assert.Equal(t, int64(4000), settings.Port)
+	assert.Equal(t, "http", settings.Protocol)
+	assert.False(t, settings.Secure)
+	assert.NoError(t, settings.isValid())
+}
+
+func TestLoadSettingsWithHTTPSURLHostNoPort(t *testing.T) {
+	jsonData := map[string]interface{}{
+		"host": "https://greptime.example.com",
+	}
+	raw, _ := json.Marshal(jsonData)
+	settings, err := LoadSettings(testCtxWithSQLDefaults(), backend.DataSourceInstanceSettings{JSONData: raw})
+	assert.NoError(t, err)
+	assert.Equal(t, "greptime.example.com", settings.Host)
+	assert.Equal(t, int64(443), settings.Port)
+	assert.True(t, settings.Secure)
+	assert.NoError(t, settings.isValid())
+}
+
+// Bare host + explicit port must keep working exactly as before.
+func TestLoadSettingsBareHostUnchanged(t *testing.T) {
+	jsonData := map[string]interface{}{
+		"host":     "127.0.0.1",
+		"port":     float64(4000),
+		"protocol": "http",
+	}
+	raw, _ := json.Marshal(jsonData)
+	settings, err := LoadSettings(testCtxWithSQLDefaults(), backend.DataSourceInstanceSettings{JSONData: raw})
+	assert.NoError(t, err)
+	assert.Equal(t, "127.0.0.1", settings.Host)
+	assert.Equal(t, int64(4000), settings.Port)
+	assert.Equal(t, "http", settings.Protocol)
+}
+
+// Explicit port wins over the URL's port.
+func TestLoadSettingsURLHostExplicitPortPriority(t *testing.T) {
+	jsonData := map[string]interface{}{
+		"host": "http://127.0.0.1:4000",
+		"port": float64(9999),
+	}
+	raw, _ := json.Marshal(jsonData)
+	settings, err := LoadSettings(testCtxWithSQLDefaults(), backend.DataSourceInstanceSettings{JSONData: raw})
+	assert.NoError(t, err)
+	assert.Equal(t, "127.0.0.1", settings.Host)
+	assert.Equal(t, int64(9999), settings.Port)
+}
+
+func TestLoadSettingsURLHostWithPath(t *testing.T) {
+	jsonData := map[string]interface{}{
+		"host": "http://127.0.0.1:4000/custom/path",
+	}
+	raw, _ := json.Marshal(jsonData)
+	settings, err := LoadSettings(testCtxWithSQLDefaults(), backend.DataSourceInstanceSettings{JSONData: raw})
+	assert.NoError(t, err)
+	assert.Equal(t, "127.0.0.1", settings.Host)
+	assert.Equal(t, "/custom/path", settings.Path)
+}

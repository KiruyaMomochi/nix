/* Plain dark box; border colours follow hyprland's default active border. */
* {
    bg:     #1e1e2ee6;
    bg-alt: #ffffff14;
    fg:     #cdd6f4;
    dim:    #7f849c;
    accent: #33ccff;
    background-color: transparent;
    text-color: @fg;
}
window {
    width: 640px;
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 10px;
    padding: 14px;
}
mainbox  { spacing: 10px; children: [ inputbar, listview ]; }
inputbar { padding: 8px 10px; border-radius: 6px; background-color: @bg-alt; children: [ entry ]; }
entry    { placeholder: "跑點什麼…"; placeholder-color: @dim; }
listview { lines: 8; spacing: 2px; scrollbar: false; }
element  { padding: 6px 10px; border-radius: 6px; spacing: 10px; }
element selected { background-color: #33ccff33; }
element-icon { size: 20px; }
element-text { vertical-align: 0.5; }
